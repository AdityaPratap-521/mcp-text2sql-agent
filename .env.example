# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Options: claude-3-opus-20240229, claude-3-5-sonnet-20241022, mock

# Database Configuration (PostgreSQL Staging DB)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics_db
DB_USER=analytics_user
DB_PASSWORD=analytics_password

# MCP Transport Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio  # Options: stdio, sse

# Agent Configuration
AUTO_UAT_APPROVAL=true  # Set false for interactive CLI UAT user prompts
MAX_REVISION_CYCLES=3
